# Compatibility filename; use docker/Dockerfile for new deployments.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MOZ_HEADLESS=1 FIREFOX_BINARY=/usr/bin/firefox-esr \
    PODCAST_OUTPUT_FOLDER=/app/output
RUN apt-get update && apt-get install -y --no-install-recommends firefox-esr ffmpeg ca-certificates openssh-server supervisor gosu \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
COPY docker/requirements.txt ./docker/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt -r docker/requirements.txt
ARG PODCAST_UID=1000
ARG PODCAST_GID=1000
RUN groupadd --gid ${PODCAST_GID} podcast \
    && useradd --create-home --uid ${PODCAST_UID} --gid podcast podcast \
    && mkdir -p /srv/sftp/downloads /var/lib/podcast-ssh \
    && chown podcast:podcast /srv/sftp/downloads \
    && ln -s /srv/sftp/downloads /app/output \
    && rm -f /etc/ssh/ssh_host_*
COPY --chown=podcast:podcast *.py ./
COPY --chown=podcast:podcast services/ ./services/
COPY --chown=podcast:podcast web/ ./web/
COPY --chown=podcast:podcast res/config.json ./res/config.json
USER podcast
# Cache the Linux driver at build time; no Windows executable is copied.
RUN python -c "from webdriver_manager.firefox import GeckoDriverManager; GeckoDriverManager().install()"
USER root
COPY docker/entrypoint.sh /usr/local/bin/podcast-entrypoint
COPY docker/sshd_config /etc/ssh/sshd_config
COPY docker/supervisord.conf /etc/supervisor/podcast.conf
RUN chmod 755 /usr/local/bin/podcast-entrypoint
EXPOSE 5000 22
ENTRYPOINT ["/usr/local/bin/podcast-entrypoint"]
